{
  "name": "@wekux/opencode-wechat-approve-plugin",
  "version": "1.1.1",
  "description": "OpenCode WeChat notifications and remote permission approvals via the ilink API",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wechat-approve": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/run-tests.js",
    "coverage": "npm run build && c8 --reporter=text --reporter=lcov node --test test/run-tests.js",
    "test:e2e": "node scripts/e2e-smoke.js",
    "test:e2e:live": "node scripts/e2e-live.js",
    "test:e2e:status": "node scripts/e2e-status.js"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opencode-ai/sdk": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@opencode-ai/sdk": "^1.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "c8": "^12.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "opencode",
    "wechat",
    "approval",
    "notification",
    "plugin",
    "ai",
    "chatbot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weikunzl/opencode-wechat-approve-plugin.git"
  }
}
