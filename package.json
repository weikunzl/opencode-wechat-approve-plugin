{
  "name": "opencode-wechat-approve-plugin",
  "version": "1.0.0",
  "description": "OpenCode WeChat notifications and remote permission approvals via the ilink API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wechat-approve": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opencode-ai/sdk": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@opencode-ai/sdk": "^1.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "opencode",
    "wechat",
    "approval",
    "notification",
    "plugin",
    "ai",
    "chatbot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weikunzl/opencode-wechat-approve-plugin.git"
  }
}
